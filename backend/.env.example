# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=your-account-id

# Project Configuration
PROJECT_NAME=apiflow-fintech
ENVIRONMENT=dev

# DynamoDB Tables
DYNAMODB_USERS_TABLE=apiflow-fintech-users-dev
DYNAMODB_JOBS_TABLE=apiflow-fintech-jobs-dev

# S3 Buckets
S3_BUCKET_UPLOADS=apiflow-fintech-uploaded-files-dev

# Step Functions
STATE_MACHINE_ARN=arn:aws:states:ap-southeast-1:ACCOUNT_ID:stateMachine:apiflow-fintech-workflow-dev

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv