[cognito]
user_pool_id = "us-east-1_XXXXXXXXX"
client_id = "XXXXXXXXXXXXXXXXXXXXXXXXXX"
region = "us-east-1"

[backend]
url = "https://your-api-id.execute-api.us-east-1.amazonaws.com"
timeout = 60

[database]
host = "your-db.us-east-1.rds.amazonaws.com"
name = "agentflow"
user = "agentflow_user"
